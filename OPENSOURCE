local function closeUI()
    isOpen = false
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Rotation = 10,
        BackgroundTransparency = 1
    })
    tween:Play()
    tween.Completed:Connect(function()
        MainFrame.Visible = false
        OPFrame.Visible = true
        OPFrame.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(OPFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 50, 0, 50)
        }):Play()
    end)
end

CloseBtn.MouseButton1Click:Connect(closeUI)

task.spawn(function()
    while OPFrame.Parent do
        if OPFrame.Visible then
            TweenService:Create(OPStroke, TweenInfo.new(1), {Transparency = 0.6}):Play()
            task.wait(1)
            TweenService:Create(OPStroke, TweenInfo.new(1), {Transparency = 0.3}):Play()
            task.wait(1)
        else
            task.wait(0.5)
        end
    end
end)

