local function handleSend()
    local raw = TextBox.Text
    if raw == "" then return end
    TextBox.Text = ""
    StatusLabel.Text = "🚀 翻訳＆送信中..."
    StatusLabel.TextColor3 = Color3.fromRGB(190, 190, 210)
    task.spawn(function()
        local tr = translateText(raw, currentSourceLang, currentTargetLang)
        if tr and tr ~= "" then
            sendChatMessage(tr)
            StatusLabel.Text = "✅ 送信: " .. tr
            StatusLabel.TextColor3 = Color3.fromRGB(150, 240, 170)
        else
            StatusLabel.Text = "⚠️ 翻訳通信エラー"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 110, 110)
        end
    end)
end

