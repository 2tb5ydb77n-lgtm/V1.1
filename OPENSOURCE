local function doHttpGet(url)
    local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or (http and http.request)
    if req then
        local ok, res = pcall(function() return req({Url=url, Method="GET"}) end)
        if ok and res and res.Body and res.Body ~= "" then return res.Body end
    end
    local ok2, body = pcall(function() return game:HttpGet(url) end)
    if ok2 and body and body ~= "" then return body end
    return nil
end

local function translateText(text, sourceLang, targetLang)
    local encoded = HttpService:UrlEncode(text)
    local gUrl = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=" .. sourceLang .. "&tl=" .. targetLang .. "&dt=t&q=" .. encoded
    local gBody = doHttpGet(gUrl)
    if gBody then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(gBody) end)
        if ok and decoded and type(decoded[1]) == "table" then
            local result = ""
            for _, seg in ipairs(decoded[1]) do
                if type(seg) == "table" and type(seg[1]) == "string" then result = result .. seg[1] end
            end
            if result ~= "" then return result end
        end
    end
    return nil
end

local function sendChatMessage(message)
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if ch then ch:SendAsync(message); return end
    end
    local d = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if d then
        local s = d:FindFirstChild("SayMessageRequest")
        if s then s:FireServer(message, "All"); return end
    end
end

